<!doctype html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Atelier</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    window.ATELIER_API_BASE = '/api';
  </script>
</head>

<body class="bg-gray-50 text-gray-900 font-sans min-h-screen">

  <!-- APP -->
  <div id="app">

    <!-- STORE -->
    <section id="store-page">

      <header class="bg-white border-b sticky top-0 z-30">
        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
          <button onclick="setPage('store')" class="text-2xl font-bold tracking-tight">
            Atelier
          </button>

          <div class="flex items-center gap-3">
            <button
              onclick="openCart()"
              class="relative px-4 py-2 rounded-xl bg-black text-white hover:bg-gray-800 transition"
            >
              Carrinho
              <span
                id="cart-count"
                class="ml-1 inline-flex min-w-5 h-5 px-1 items-center justify-center rounded-full bg-white text-black text-xs font-bold"
              >0</span>
            </button>

            <button
              onclick="setPage('admin')"
              class="px-4 py-2 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 transition"
            >
              Admin
            </button>
          </div>
        </div>
      </header>

      <main class="max-w-6xl mx-auto p-4 md:p-6 pb-24 min-h-screen">
        <div class="mb-6">
          <h1 class="text-3xl font-bold">Produtos</h1>
          <p class="text-gray-500 mt-1">Conheça a nossa coleção.</p>
        </div>

        <div
          id="store-products"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        ></div>
      </main>
    </section>


    <!-- ADMIN -->
    <section id="admin-page" class="hidden">

      <header class="bg-black text-white sticky top-0 z-30">
        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
          <button onclick="setPage('admin')" class="text-xl font-bold">
            Atelier Admin
          </button>

          <div class="flex items-center gap-3">
            <button
              onclick="setPage('store')"
              class="px-4 py-2 rounded-xl bg-white text-black hover:bg-gray-200 transition"
            >
              Loja
            </button>

            <button
              onclick="logout()"
              class="px-4 py-2 rounded-xl border border-white/30 hover:bg-white/10 transition"
            >
              Sair
            </button>
          </div>
        </div>
      </header>

      <main class="max-w-6xl mx-auto p-4 md:p-6 pb-24 min-h-screen">

        <!-- LOGIN -->
        <div id="admin-login" class="max-w-md mx-auto mt-12">
          <div class="bg-white rounded-2xl border shadow-sm p-6">
            <h2 class="text-2xl font-bold mb-2">Entrar</h2>
            <p class="text-gray-500 mb-6">
              Acede ao painel administrativo.
            </p>

            <form onsubmit="login(event)" class="space-y-4">
              <div>
                <label class="block text-sm font-medium mb-1">Email</label>
                <input
                  id="login-email"
                  type="email"
                  required
                  class="w-full border rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-black"
                />
              </div>

              <div>
                <label class="block text-sm font-medium mb-1">Password</label>
                <input
                  id="login-password"
                  type="password"
                  required
                  class="w-full border rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-black"
                />
              </div>

              <button
                type="submit"
                class="w-full bg-black text-white rounded-xl py-3 font-semibold hover:bg-gray-800"
              >
                Entrar
              </button>
            </form>

            <button
              onclick="forgotPassword()"
              class="mt-4 text-sm underline text-gray-600"
            >
              Esqueci a password
            </button>
          </div>
        </div>


        <!-- ADMIN CONTENT -->
        <div id="admin-content" class="hidden">

          <!-- TABS -->
          <div class="flex gap-2 overflow-x-auto pb-2 mb-6">
            <button
              onclick="switchTab('dashboard')"
              class="admin-tab px-4 py-2 rounded-xl border bg-white"
            >
              Dashboard
            </button>

            <button
              onclick="switchTab('orders')"
              class="admin-tab px-4 py-2 rounded-xl border bg-white"
            >
              Pedidos
            </button>

            <button
              onclick="switchTab('products')"
              class="admin-tab px-4 py-2 rounded-xl border bg-white"
            >
              Produtos
            </button>

            <button
              onclick="switchTab('settings')"
              class="admin-tab px-4 py-2 rounded-xl border bg-white"
            >
              Definições
            </button>

            <button
              onclick="switchTab('audit')"
              class="admin-tab px-4 py-2 rounded-xl border bg-white"
            >
              Auditoria
            </button>
          </div>


          <!-- DASHBOARD -->
          <div id="admin-dashboard-tab" class="admin-content">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="bg-white rounded-2xl border p-5">
                <p class="text-sm text-gray-500">Pedidos</p>
                <p id="stat-orders" class="text-3xl font-bold mt-2">0</p>
              </div>

              <div class="bg-white rounded-2xl border p-5">
                <p class="text-sm text-gray-500">Produtos</p>
                <p id="stat-products" class="text-3xl font-bold mt-2">0</p>
              </div>

              <div class="bg-white rounded-2xl border p-5">
                <p class="text-sm text-gray-500">Receita</p>
                <p id="stat-revenue" class="text-3xl font-bold mt-2">0</p>
              </div>
            </div>
          </div>


          <!-- ORDERS -->
          <div id="admin-orders-tab" class="admin-content hidden">

            <div class="flex items-center justify-between mb-5">
              <div>
                <h2 class="text-2xl font-bold">Pedidos</h2>
                <p class="text-gray-500">Gestão dos pedidos recebidos.</p>
              </div>
            </div>

            <div
              id="admin-orders"
              class="space-y-4"
            ></div>

          </div>


          <!-- PRODUCTS -->
          <div id="admin-products-tab" class="admin-content hidden">

            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">

              <div>
                <h2 class="text-2xl font-bold">Produtos</h2>
                <p class="text-gray-500">
                  Adiciona, edita e gere os produtos da loja.
                </p>
              </div>

              <button
                onclick="newProduct()"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-black text-white font-semibold hover:bg-gray-800 transition"
              >
                <span class="text-lg">+</span>
                Novo produto
              </button>

            </div>


            <div class="bg-white rounded-2xl border shadow-sm overflow-hidden">

              <div class="p-4 border-b flex flex-col sm:flex-row gap-3">

                <input
                  id="product-search"
                  type="search"
                  placeholder="Pesquisar produtos..."
                  class="flex-1 border rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-black"
                  oninput="loadAdmin()"
                />

                <select
                  id="product-filter"
                  onchange="loadAdmin()"
                  class="border rounded-xl px-4 py-3 bg-white outline-none"
                >
                  <option value="all">Todos</option>
                  <option value="active">Ativos</option>
                  <option value="inactive">Inativos</option>
                </select>

              </div>

              <div
                id="admin-products"
                class="divide-y"
              ></div>

            </div>

          </div>


          <!-- SETTINGS -->
          <div id="admin-settings-tab" class="admin-content hidden">

            <div class="max-w-2xl">
              <h2 class="text-2xl font-bold mb-1">Definições</h2>
              <p class="text-gray-500 mb-6">
                Configurações da loja e da conta.
              </p>

              <div class="space-y-6">

                <div class="bg-white border rounded-2xl p-5">
                  <h3 class="font-bold mb-4">Loja</h3>

                  <div class="space-y-4">
                    <div>
                      <label class="block text-sm font-medium mb-1">
                        Nome da loja
                      </label>
                      <input
                        id="settings-store-name"
                        class="w-full border rounded-xl px-4 py-3"
                      />
                    </div>

                    <div>
                      <label class="block text-sm font-medium mb-1">
                        Moeda
                      </label>
                      <input
                        id="settings-currency"
                        class="w-full border rounded-xl px-4 py-3"
                        placeholder="MZN"
                      />
                    </div>
                  </div>
                </div>


                <div class="bg-white border rounded-2xl p-5">
                  <h3 class="font-bold mb-4">Segurança</h3>

                  <button
                    onclick="changePassword()"
                    class="px-4 py-3 rounded-xl border font-medium hover:bg-gray-50"
                  >
                    Alterar password
                  </button>

                  <button
                    onclick="start2fa()"
                    class="ml-2 px-4 py-3 rounded-xl bg-black text-white font-medium hover:bg-gray-800"
                  >
                    Configurar 2FA
                  </button>
                </div>


                <button
                  onclick="saveSettings()"
                  class="px-5 py-3 rounded-xl bg-black text-white font-semibold"
                >
                  Guardar definições
                </button>

              </div>
            </div>

          </div>


          <!-- AUDIT -->
          <div id="admin-audit-tab" class="admin-content hidden">

            <div class="mb-6">
              <h2 class="text-2xl font-bold">Auditoria</h2>
              <p class="text-gray-500">
                Histórico das ações administrativas.
              </p>
            </div>

            <div
              id="admin-audit"
              class="bg-white rounded-2xl border divide-y"
            ></div>

          </div>

        </div>

      </main>

    </section>


    <!-- CART MODAL -->
    <div
      id="cart-modal"
      class="fixed inset-0 z-50 hidden"
    >
      <div
        class="absolute inset-0 bg-black/50"
        onclick="openCart(false)"
      ></div>

      <div class="absolute inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl flex flex-col">

        <div class="p-5 border-b flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold">Carrinho</h2>
            <p class="text-sm text-gray-500">Os teus produtos.</p>
          </div>

          <button
            onclick="openCart(false)"
            class="w-10 h-10 rounded-full hover:bg-gray-100 text-xl"
          >
            ×
          </button>
        </div>

        <div
          id="cart-items"
          class="flex-1 overflow-y-auto p-5"
        ></div>

        <div class="p-5 border-t">
          <div class="flex items-center justify-between mb-4">
            <span class="text-gray-500">Total</span>
            <strong id="cart-total" class="text-xl">0</strong>
          </div>

          <button
            onclick="checkout()"
            class="w-full bg-black text-white rounded-xl py-3 font-semibold"
          >
            Finalizar compra
          </button>
        </div>

      </div>
    </div>


    <!-- PRODUCT MODAL -->
    <div
      id="prod-modal"
      class="fixed inset-0 z-[60] hidden bg-black/50 p-2 sm:p-4"
    >

      <div class="min-h-full flex items-center justify-center">

        <div
          class="w-full max-w-3xl bg-white rounded-2xl shadow-2xl max-h-[calc(100vh-1rem)] sm:max-h-[calc(100vh-2rem)] overflow-hidden flex flex-col"
        >

          <!-- MODAL HEADER -->
          <div class="px-5 sm:px-6 py-4 border-b flex items-center justify-between shrink-0">

            <div>
              <p class="text-xs uppercase tracking-widest text-gray-400 font-semibold">
                Catálogo
              </p>

              <h2
                id="prod-modal-title"
                class="text-xl sm:text-2xl font-bold mt-1"
              >
                Novo produto
              </h2>
            </div>

            <button
              type="button"
              onclick="document.getElementById('prod-modal').classList.add('hidden')"
              class="w-10 h-10 rounded-full hover:bg-gray-100 text-2xl text-gray-500"
            >
              ×
            </button>

          </div>


          <!-- MODAL BODY -->
          <div class="flex-1 overflow-y-auto">

            <form
              id="product-form"
              onsubmit="saveProduct(event)"
              class="p-5 sm:p-6 space-y-7"
            >

              <input
                type="hidden"
                id="prod-id"
              />


              <!-- INFORMATION -->
              <section>

                <div class="mb-4">
                  <h3 class="font-bold text-lg">Informações</h3>
                  <p class="text-sm text-gray-500">
                    Dados principais do produto.
                  </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                  <div class="md:col-span-2">
                    <label class="block text-sm font-semibold mb-1">
                      Nome do produto
                    </label>

                    <input
                      id="prod-name"
                      required
                      placeholder="Ex.: Vestido Elegance"
                      class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-black"
                    />
                  </div>


                  <div>
                    <label class="block text-sm font-semibold mb-1">
                      Referência
                    </label>

                    <input
                      id="prod-ref"
                      placeholder="Ex.: ATL-001"
                      class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-black"
                    />
                  </div>


                  <div>
                    <label class="block text-sm font-semibold mb-1">
                      Preço
                    </label>

                    <input
                      id="prod-price"
                      type="number"
                      min="0"
                      step="0.01"
                      required
                      placeholder="0.00"
                      class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-black"
                    />
                  </div>


                  <div>
                    <label class="block text-sm font-semibold mb-1">
                      Moeda
                    </label>

                    <select
                      id="prod-currency"
                      class="w-full border border-gray-300 rounded-xl px-4 py-3 bg-white outline-none focus:ring-2 focus:ring-black"
                    >
                      <option value="MZN">MZN — Metical</option>
                      <option value="USD">USD — Dólar</option>
                      <option value="EUR">EUR — Euro</option>
                      <option value="ZAR">ZAR — Rand</option>
                    </select>
                  </div>


                  <div class="md:col-span-2">
                    <label class="block text-sm font-semibold mb-1">
                      Descrição
                    </label>

                    <textarea
                      id="prod-desc"
                      rows="4"
                      placeholder="Descreve o produto, material, detalhes..."
                      class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-black resize-y"
                    ></textarea>
                  </div>

                </div>

              </section>


              <!-- PHOTOS -->
              <section class="border-t pt-7">

                <div class="mb-4">
                  <h3 class="font-bold text-lg">Fotografias</h3>
                  <p class="text-sm text-gray-500">
                    Escolhe quantas fotografias queres publicar neste produto.
                  </p>
                </div>


                <div class="bg-gray-50 border rounded-2xl p-4">

                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">

                    <div>
                      <label
                        for="prod-image-count"
                        class="block text-sm font-semibold"
                      >
                        Número de fotografias
                      </label>

                      <p class="text-xs text-gray-500 mt-1">
                        Podes adicionar até 6 fotografias.
                      </p>
                    </div>

                    <select
                      id="prod-image-count"
                      onchange="renderPhotoInputs()"
                      class="w-full sm:w-40 border border-gray-300 rounded-xl px-4 py-3 bg-white font-semibold outline-none focus:ring-2 focus:ring-black"
                    >
                      <option value="1">1 fotografia</option>
                      <option value="2">2 fotografias</option>
                      <option value="3">3 fotografias</option>
                      <option value="4">4 fotografias</option>
                      <option value="5">5 fotografias</option>
                      <option value="6">6 fotografias</option>
                    </select>

                  </div>


                  <div
                    id="prod-image-inputs"
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
                  ></div>

                  <input
                    id="prod-image"
                    type="hidden"
                  />

                  <p class="text-xs text-gray-500 mt-4">
                    A primeira fotografia será usada como imagem principal do produto.
                  </p>

                </div>

              </section>


              <!-- STOCK -->
              <section class="border-t pt-7">

                <div class="mb-4">
                  <h3 class="font-bold text-lg">Stock por tamanho</h3>
                  <p class="text-sm text-gray-500">
                    Indica quantas unidades tens disponíveis.
                  </p>
                </div>


                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">

                  <div>
                    <label class="block text-xs font-semibold text-gray-500 mb-1">
                      P
                    </label>

                    <input
                      id="prod-stock-p"
                      type="number"
                      min="0"
                      value="0"
                      class="w-full border rounded-xl px-4 py-3"
                    />
                  </div>


                  <div>
                    <label class="block text-xs font-semibold text-gray-500 mb-1">
                      M
                    </label>

                    <input
                      id="prod-stock-m"
                      type="number"
                      min="0"
                      value="0"
                      class="w-full border rounded-xl px-4 py-3"
                    />
                  </div>


                  <div>
                    <label class="block text-xs font-semibold text-gray-500 mb-1">
                      G
                    </label>

                    <input
                      id="prod-stock-g"
                      type="number"
                      min="0"
                      value="0"
                      class="w-full border rounded-xl px-4 py-3"
                    />
                  </div>


                  <div>
                    <label class="block text-xs font-semibold text-gray-500 mb-1">
                      GG
                    </label>

                    <input
                      id="prod-stock-gg"
                      type="number"
                      min="0"
                      value="0"
                      class="w-full border rounded-xl px-4 py-3"
                    />
                  </div>

                </div>


                <label class="flex items-center gap-3 mt-5 cursor-pointer">

                  <input
                    id="prod-limited"
                    type="checkbox"
                    class="w-5 h-5 rounded"
                  />

                  <span>
                    <span class="block font-semibold text-sm">
                      Edição limitada
                    </span>

                    <span class="block text-xs text-gray-500">
                      Marcar este produto como edição limitada.
                    </span>
                  </span>

                </label>

              </section>

            </form>

          </div>


          <!-- MODAL FOOTER -->
          <div class="shrink-0 border-t bg-white px-5 sm:px-6 py-4 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3">

            <button
              type="button"
              onclick="document.getElementById('prod-modal').classList.add('hidden')"
              class="w-full sm:w-auto px-5 py-3 rounded-xl border border-gray-300 font-semibold hover:bg-gray-50"
            >
              Cancelar
            </button>

            <button
              type="submit"
              form="product-form"
              class="w-full sm:w-auto px-6 py-3 rounded-xl bg-black text-white font-semibold hover:bg-gray-800"
            >
              Guardar produto
            </button>

          </div>

        </div>

      </div>

    </div>


    <!-- PRODUCT VIEW MODAL -->
    <div
      id="product-view-modal"
      class="fixed inset-0 z-50 hidden bg-black/50 p-4"
    >
      <div class="min-h-full flex items-center justify-center">

        <div class="w-full max-w-3xl bg-white rounded-2xl shadow-2xl max-h-[calc(100vh-2rem)] overflow-y-auto">

          <div class="p-5 border-b flex justify-between">
            <h2 class="text-xl font-bold">Produto</h2>

            <button
              onclick="document.getElementById('product-view-modal').classList.add('hidden')"
              class="w-10 h-10 rounded-full hover:bg-gray-100 text-2xl"
            >
              ×
            </button>
          </div>

          <div id="product-view-content" class="p-6"></div>

        </div>

      </div>
    </div>


    <!-- ORDER VIEW MODAL -->
    <div
      id="order-view-modal"
      class="fixed inset-0 z-50 hidden bg-black/50 p-4"
    >
      <div class="min-h-full flex items-center justify-center">

        <div class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl max-h-[calc(100vh-2rem)] overflow-y-auto">

          <div class="p-5 border-b flex justify-between">
            <h2 class="text-xl font-bold">Pedido</h2>

            <button
              onclick="document.getElementById('order-view-modal').classList.add('hidden')"
              class="w-10 h-10 rounded-full hover:bg-gray-100 text-2xl"
            >
              ×
            </button>
          </div>

          <div id="order-view-content" class="p-6"></div>

        </div>

      </div>
    </div>


    <!-- 2FA MODAL -->
    <div
      id="twofa-modal"
      class="fixed inset-0 z-50 hidden bg-black/50 p-4"
    >
      <div class="min-h-full flex items-center justify-center">

        <div class="w-full max-w-lg bg-white rounded-2xl shadow-2xl p-6">

          <div class="flex items-center justify-between mb-5">
            <h2 class="text-xl font-bold">Autenticação 2FA</h2>

            <button
              onclick="document.getElementById('twofa-modal').classList.add('hidden')"
              class="text-2xl text-gray-500"
            >
              ×
            </button>
          </div>

          <div id="twofa-content"></div>

        </div>

      </div>
    </div>


    <!-- RESET PASSWORD MODAL -->
    <div
      id="reset-modal"
      class="fixed inset-0 z-50 hidden bg-black/50 p-4"
    >
      <div class="min-h-full flex items-center justify-center">

        <div class="w-full max-w-lg bg-white rounded-2xl shadow-2xl p-6">

          <h2 class="text-xl font-bold mb-5">
            Recuperar password
          </h2>

          <div id="reset-content"></div>

        </div>

      </div>
    </div>

  </div>


  <!-- API -->
  <script src="js/api.js"></script>

  <!-- APP -->
  <script src="js/app.js"></script>

</body>
</html>
