generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentMethod {
  MANUAL
  MPESA
  EMOLA
  MOCK
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum Currency {
  MT
  EUR
  USD
  BRL
  GBP
}

enum UserRole {
  ADMIN
  MANAGER
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String
  role                UserRole              @default(ADMIN)
  twoFactorSecret     String?
  twoFactorEnabled    Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  recoveryCodes       RecoveryCode[]
  sessions            Session[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  csrfTokenHash String @unique
  userId String
  expiresAt DateTime
  twoFactorPending Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  ref         String        @unique
  description String?
  price       Decimal       @db.Decimal(12, 2)
  currency    Currency      @default(MT)
  imageUrl    String?
  limited     Boolean       @default(false)
  active      Boolean       @default(true)
  sizes       ProductSize[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  size      String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model Order {
  id                      String            @id @default(cuid())
  idempotencyKey          String?           @unique
  idempotencyRequestHash  String?
  status                  OrderStatus       @default(PENDING)
  fulfillmentMethod       FulfillmentMethod @default(DELIVERY)
  currency                Currency
  subtotal                Decimal           @db.Decimal(12, 2)
  deliveryCost            Decimal           @default(0) @db.Decimal(12, 2)
  total                   Decimal           @db.Decimal(12, 2)
  customerName            String?
  customerPhone           String?
  country                 String?
  city                    String?
  address                 String?
  latitude                Decimal?          @db.Decimal(10, 7)
  longitude               Decimal?          @db.Decimal(10, 7)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  items                   OrderItem[]
  payments                Payment[]
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String
  productNameSnapshot String
  productRefSnapshot  String
  unitPrice           Decimal  @db.Decimal(12, 2)
  quantity            Int
  size                String
  subtotal            Decimal  @db.Decimal(12, 2)
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RecoveryCode {
  id String @id @default(cuid())
  userId String
  codeHash String
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Payment {
  id String @id @default(cuid())
  orderId String
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  provider String
  providerReference String? @unique
  idempotencyKey String @unique
  amount Decimal @db.Decimal(12,2)
  currency Currency
  customerPhone String?
  failureReason String?
  failureCode String?
  providerPayload Json?
  providerTransactionId String?
  expiresAt DateTime?
  paidAt DateTime?
  refundedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  events PaymentEvent[]
  @@index([orderId])
  @@index([status, createdAt])
}

model PaymentEvent {
  id String @id @default(cuid())
  paymentId String
  type String
  providerEventId String? @unique
  payload Json?
  createdAt DateTime @default(now())
  payment Payment @relation(fields:[paymentId], references:[id], onDelete:Cascade)
  @@index([paymentId])
}
